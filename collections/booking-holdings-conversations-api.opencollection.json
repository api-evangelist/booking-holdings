{
  "opencollection": "1.0.0",
  "info": {
    "name": "Booking.com Demand Accommodations Conversations API",
    "version": "3.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Conversations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Booking.com Retrieve a Conversation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://demandapi.booking.com/3.1/messages/conversations",
            "headers": [
              {
                "name": "X-Affiliate-Id",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieves a conversation accessible to the authenticated user, including message history and participants.\n"
        }
      ]
    }
  ],
  "bundled": true
}